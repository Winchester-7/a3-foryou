# --- публичные адреса (подставляются при сборке) ---
NEXT_PUBLIC_SITE_URL=https://a3.kg
NEXT_PUBLIC_PLANNER_URL=https://a3-foryou-3d.netlify.app

# --- админ-панель ---
# пароль входа в /admin; без него админка выключена
ADMIN_PASSWORD=
# необязательно: отдельный секрет для подписи cookie
ADMIN_SESSION_SECRET=

# --- хранилище данных ---
# папка с JSON-файлами и загруженными фото (в Docker это том /data)
DATA_DIR=./.data

# --- docker-compose (на сервере) ---
# A3_IMAGE=registry.gitlab.com/GROUP/a3-site:latest
# A3_CONTAINER=a3-site
# A3_PORT=3000
